{
  // The model's own check: `pnpm exec tsc -p verification/models/lighthouse-wait`. It holds the
  // model to the packages' strictest settings, so a package's tests can import the conformance
  // traces as they are.
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": true,
    "isolatedDeclarations": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    // The model has no packages of its own: Node's types come from the Node Lighthouse's.
    "typeRoots": ["../../../apps/lighthouse/node_modules/@types"]
  },
  "include": ["model"]
}
