language js(jsx)

// Test fakes and contract tests are for test files. This reports any way of importing or
// re-exporting one from a file that isn't a test: `@pigeon/core/testing`,
// `@pigeon/lighthouse/testing`, a relative path through a `testing/` folder, or a
// `store-contract` file, in a static import, an `export ... from`, or a dynamic `import()`.
// It also reports taking a fake by name from `@pigeon/core`, which still exports them from its
// index: `fakePake`, `fakeCrypto`, `fakeSealCrypto`, `fakeSigner`, `createMemoryNetwork`,
// `MemoryNetwork`, `flush` and `relayRoom`, in an import or an `export { ... } from`.
// biome.json loads this plugin for every file but the tests, the `testing/` folders themselves and
// each package's index.ts.
or {
  or {
    JsModuleSource() as $source,
    JsStringLiteralExpression() as $source where { $source <: within `import($_)` }
  } where {
    $source <: r"['\"](?:@pigeon/(?:core|lighthouse)/testing|\.{1,2}/(?:[^'\"]*/)?testing(?:/[^'\"]*)?|[^'\"]*store-contract[^'\"]*)['\"]",
    register_diagnostic(span=$source, message="Test fakes and contract tests are for test files only: @pigeon/core/testing, @pigeon/lighthouse/testing, anything in a testing/ folder and store-contract.", severity="error")
  },
  or {
    JsImport() as $named,
    JsExport() as $named
  } where {
    $named <: r"(?s)\b(?:import|export)\s+(?:type\s+)?(?:\w+\s*,\s*)?\{[^}]*\b(?:fakePake|fakeCrypto|fakeSealCrypto|fakeSigner|createMemoryNetwork|MemoryNetwork|flush|relayRoom)\b[^}]*\}\s*from\s*['\"]@pigeon/core['\"]",
    register_diagnostic(span=$named, message="Test fakes and contract tests are for test files only: @pigeon/core also exports the fakes from its index (fakePake, fakeCrypto, fakeSealCrypto, fakeSigner, createMemoryNetwork, MemoryNetwork, flush, relayRoom), and a non-test file may not take them from there.", severity="error")
  }
}
