{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!**/dist",
      "!assets",
      "!apps/web/src/icons",
      "!apps/web/src/fonts",
      "!packages/core/src/testing/wycheproof",
      "!apps/web/src/apps/**/*.html"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "plugins": ["./biome-plugins/solid-stale-accessor.grit"],
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": {
          "level": "error",
          "options": { "ignoreTypes": true }
        }
      },
      "style": {
        "useImportType": "error",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": { "maxLines": 600 }
        },
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 1000 }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/apps/messenger/add-friend/add-friend.tsx",
        "packages/core/src/avatar/avatar.ts",
        "packages/core/src/chat/pair-session.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 700 }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/devices/device-log.ts", "packages/pigeonhtml/src/css.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 800 }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/app/programs.tsx", "packages/core/src/chat/pair-session.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 1100 }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/apps/messenger/service/invite-links.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 1300 }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/apps/messenger/service/service.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 3200 }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/apps/messenger/service/service.test.ts"],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": {
              "level": "error",
              "options": { "maxLines": 4500 }
            }
          }
        }
      }
    },
    {
      "includes": ["**", "!**/*.test.ts", "!**/*.test.tsx"],
      "plugins": ["./biome-plugins/no-test-fakes.grit"]
    },
    {
      "includes": ["packages/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/*"],
                    "message": "packages/ stay framework-free; Solid is for apps/web/src/ui, shell and apps."
                  },
                  {
                    "group": ["**/apps/**"],
                    "message": "packages/ must not depend on apps/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/platform/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/*"],
                    "message": "platform/ wraps browser APIs and stays framework-free."
                  },
                  {
                    "group": ["**/ui", "**/ui/**", "**/shell", "**/shell/**", "**/apps/**"],
                    "message": "platform/ may import only packages/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/platform",
                      "**/platform/**",
                      "**/shell",
                      "**/shell/**",
                      "**/apps/**"
                    ],
                    "message": "ui/ is the presentational kit: Solid and packages/ only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shell/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/apps/**", "**/app", "**/app/**"],
                    "message": "shell/ may import ui/, packages/ and platform interfaces; app/ hands it everything else."
                  },
                  {
                    "group": [
                      "**/platform/**",
                      "!**/platform/clock/clock.ts",
                      "!**/platform/files/files.ts",
                      "!**/platform/storage/storage.ts",
                      "!**/platform/wake/wake.ts"
                    ],
                    "message": "shell/ takes platform interfaces from app/, never an implementation. An interface file (clock.ts, files.ts, ...) is allowed by name in biome.json."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/apps/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/shell", "**/shell/**", "**/app", "**/app/**"],
                    "message": "apps/ may import themselves, ui/, packages/ and platform interfaces."
                  },
                  {
                    "group": ["../../*", "../../*/**", "!../../../**"],
                    "message": "An app never imports another app; share through ui/ or packages/. App files live one folder deep: apps/<app>/<component>/."
                  },
                  {
                    "group": [
                      "**/platform/**",
                      "!**/platform/clock/clock.ts",
                      "!**/platform/files/files.ts",
                      "!**/platform/storage/storage.ts",
                      "!**/platform/wake/wake.ts"
                    ],
                    "message": "apps/ take platform interfaces from app/, never an implementation. An interface file (clock.ts, files.ts, ...) is allowed by name in biome.json."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "cssModules": true
    }
  }
}
