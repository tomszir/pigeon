{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.claude",
      "!**/dist",
      "!assets",
      "!apps/web/src/icons",
      "!apps/web/src/fonts",
      "!packages/core/src/testing/wycheproof",
      "!apps/web/src/apps/**/*.html"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  },
  "plugins": ["./biome-plugins/solid-stale-accessor.grit"],
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      },
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "error"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/*/src/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off",
            "noReExportAll": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/testing/index.ts"],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/testing/**",
        "!packages/*/src/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/*"],
                    "message": "packages/ stay framework-free; Solid is for apps/web/src/ui, shell and apps."
                  },
                  {
                    "group": ["**/apps/**"],
                    "message": "packages/ must not depend on apps/."
                  },
                  {
                    "group": [
                      "@pigeon/core/testing",
                      "@pigeon/lighthouse/testing",
                      "@pigeon/lighthouse/wait-traces",
                      "@pigeon/lighthouse/wait-conformance"
                    ],
                    "message": "Test utilities stay in test files and testing/ folders."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/**/*.test.ts",
        "packages/**/*.test.tsx",
        "packages/**/*.spec.ts",
        "packages/**/testing/**",
        "packages/*/src/index.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/*"],
                    "message": "packages/ stay framework-free; Solid is for apps/web/src/ui, shell and apps."
                  },
                  {
                    "group": ["**/apps/**"],
                    "message": "packages/ must not depend on apps/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/app/**",
        "apps/lighthouse/src/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/*.spec.ts",
        "!**/testing/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@pigeon/core/testing",
                      "@pigeon/lighthouse/testing",
                      "@pigeon/lighthouse/wait-traces",
                      "@pigeon/lighthouse/wait-conformance"
                    ],
                    "message": "Test utilities stay in test files and testing/ folders."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/platform/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/*"],
                    "message": "platform/ wraps browser APIs and stays framework-free."
                  },
                  {
                    "group": ["**/ui", "**/ui/**", "**/shell", "**/shell/**", "**/apps/**"],
                    "message": "platform/ may import only packages/."
                  },
                  {
                    "group": [
                      "@pigeon/core/testing",
                      "@pigeon/lighthouse/testing",
                      "@pigeon/lighthouse/wait-traces",
                      "@pigeon/lighthouse/wait-conformance"
                    ],
                    "message": "Test utilities stay in test files and testing/ folders."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/platform/**/*.test.ts",
        "apps/web/src/platform/**/*.test.tsx",
        "apps/web/src/platform/**/testing/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["solid-js", "solid-js/*"],
                    "message": "platform/ wraps browser APIs and stays framework-free."
                  },
                  {
                    "group": ["**/ui", "**/ui/**", "**/shell", "**/shell/**", "**/apps/**"],
                    "message": "platform/ may import only packages/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/ui/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/platform",
                      "**/platform/**",
                      "**/shell",
                      "**/shell/**",
                      "**/apps/**"
                    ],
                    "message": "ui/ is the presentational kit: Solid and packages/ only."
                  },
                  {
                    "group": [
                      "@pigeon/core/testing",
                      "@pigeon/lighthouse/testing",
                      "@pigeon/lighthouse/wait-traces",
                      "@pigeon/lighthouse/wait-conformance"
                    ],
                    "message": "Test utilities stay in test files and testing/ folders."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/ui/**/*.test.ts",
        "apps/web/src/ui/**/*.test.tsx",
        "apps/web/src/ui/**/testing/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "**/platform",
                      "**/platform/**",
                      "**/shell",
                      "**/shell/**",
                      "**/apps/**"
                    ],
                    "message": "ui/ is the presentational kit: Solid and packages/ only."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shell/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/apps/**", "**/app", "**/app/**"],
                    "message": "shell/ may import ui/, packages/ and platform interfaces; app/ hands it everything else."
                  },
                  {
                    "group": [
                      "**/platform/**",
                      "!**/platform/clock/clock.ts",
                      "!**/platform/files/files.ts",
                      "!**/platform/storage/storage.ts",
                      "!**/platform/wake/wake.ts"
                    ],
                    "message": "shell/ takes platform interfaces from app/, never an implementation. An interface file (clock.ts, files.ts, ...) is allowed by name in biome.json."
                  },
                  {
                    "group": [
                      "@pigeon/core/testing",
                      "@pigeon/lighthouse/testing",
                      "@pigeon/lighthouse/wait-traces",
                      "@pigeon/lighthouse/wait-conformance"
                    ],
                    "message": "Test utilities stay in test files and testing/ folders."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/shell/**/*.test.ts", "apps/web/src/shell/**/*.test.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/apps/**", "**/app", "**/app/**"],
                    "message": "shell/ may import ui/, packages/ and platform interfaces; app/ hands it everything else."
                  },
                  {
                    "group": [
                      "**/platform/**",
                      "!**/platform/clock/clock.ts",
                      "!**/platform/files/files.ts",
                      "!**/platform/storage/storage.ts",
                      "!**/platform/wake/wake.ts",
                      "!**/platform/storage/memory-storage.ts"
                    ],
                    "message": "shell/ takes platform interfaces from app/, never an implementation. An interface file (clock.ts, files.ts, ...) is allowed by name in biome.json. Tests may also import memory-storage.ts."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/apps/**", "!**/*.test.ts", "!**/*.test.tsx", "!**/testing/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/shell", "**/shell/**", "**/app", "**/app/**"],
                    "message": "apps/ may import themselves, ui/, packages/ and platform interfaces."
                  },
                  {
                    "group": ["../../*", "../../*/**", "!../../../**"],
                    "message": "An app never imports another app; share through ui/ or packages/. App files live one folder deep: apps/<app>/<component>/."
                  },
                  {
                    "group": [
                      "**/platform/**",
                      "!**/platform/clock/clock.ts",
                      "!**/platform/files/files.ts",
                      "!**/platform/storage/storage.ts",
                      "!**/platform/wake/wake.ts"
                    ],
                    "message": "apps/ take platform interfaces from app/, never an implementation. An interface file (clock.ts, files.ts, ...) is allowed by name in biome.json."
                  },
                  {
                    "group": [
                      "@pigeon/core/testing",
                      "@pigeon/lighthouse/testing",
                      "@pigeon/lighthouse/wait-traces",
                      "@pigeon/lighthouse/wait-conformance"
                    ],
                    "message": "Test utilities stay in test files and testing/ folders."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "apps/web/src/apps/**/*.test.ts",
        "apps/web/src/apps/**/*.test.tsx",
        "apps/web/src/apps/**/testing/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/shell", "**/shell/**", "**/app", "**/app/**"],
                    "message": "apps/ may import themselves, ui/, packages/ and platform interfaces."
                  },
                  {
                    "group": ["../../*", "../../*/**", "!../../../**"],
                    "message": "An app never imports another app; share through ui/ or packages/. App files live one folder deep: apps/<app>/<component>/."
                  },
                  {
                    "group": [
                      "**/platform/**",
                      "!**/platform/clock/clock.ts",
                      "!**/platform/files/files.ts",
                      "!**/platform/storage/storage.ts",
                      "!**/platform/wake/wake.ts",
                      "!**/platform/storage/memory-storage.ts"
                    ],
                    "message": "apps/ take platform interfaces from app/, never an implementation. An interface file (clock.ts, files.ts, ...) is allowed by name in biome.json. Tests may also import memory-storage.ts."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "css": {
    "parser": {
      "cssModules": true
    }
  }
}
