{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static assets, plus one route that hands out short-lived TURN credentials (decision 0022).
  // Its secrets, TURN_KEY_ID and TURN_KEY_API_TOKEN, are set in the dashboard, not here.
  "name": "pigeon",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  "routes": [{ "pattern": "pigeon.tomszir.com", "custom_domain": true }]
}
