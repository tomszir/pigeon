{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/css-module-types.mjs apps/web/src && vite",
    "build": "node ../../scripts/css-module-types.mjs apps/web/src && vite build",
    "preview": "vite preview",
    "typecheck": "node ../../scripts/css-module-types.mjs apps/web/src && tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@pigeon/core": "workspace:*",
    "@pigeon/pigeonhtml": "workspace:*",
    "solid-js": "1.9.18",
    "trystero": "0.27.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@pigeon/lighthouse": "workspace:*",
    "@playwright/test": "1.65.1",
    "@solidjs/testing-library": "0.8.10",
    "@types/node": "24.19.2",
    "happy-dom": "21.0.4",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
