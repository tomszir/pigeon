{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node runs this app's TypeScript as is, stripping only the types, so syntax that has
    // to be compiled (parameter properties, enums, namespaces) would stop it starting.
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src"]
}
