#!/bin/sh
# check-docs: holds a repository to its docs/ rule.
#
#   1. A change outside docs/ comes with a change inside docs/, unless the commit
#      that made it carries the trailer "Docs: none".
#   2. Every file in docs/ is listed in docs/README.md (a listed folder, such as
#      "decisions/", covers everything inside it).
#   3. Every doc opens with a heading and then a one-line summary.
#   4. Docs and code are written for a stranger: outside docs/decisions/,
#      docs/roadmap.md and its companions (docs/roadmap-*.md), nothing cites a decision record or a milestone, links to
#      the roadmap, or mentions a homelab.
#   5. No two decision records share a number, apart from the pairs named in
#      SHARED_NUMBERS below, which were numbered in parallel before this check.
#   6. Every repository path that docs/architecture.md or docs/verification.md cites exists:
#      a `code span` starting at a top-level folder (apps/, packages/, ...) or at one of the web
#      app's (ui/, app/, platform/, shell/), or a link target, outside fenced blocks.
#
# Usage: scripts/check-docs [--base <ref>] [--hook claude]
#
# The base is what the change is measured against: --base, else $CHECK_DOCS_BASE,
# else the upstream branch, else origin's default branch. Without one, only the
# uncommitted changes are checked. Uncommitted and untracked files always count.
#
# --hook claude reads a Claude Code Stop hook's JSON on stdin and exits 2 on a
# problem, which sends the report back to the agent instead of letting it stop.
# It nudges once: when the agent is already continuing because of this hook, it
# lets it stop, and CI stays the hard gate.

set -eu

base=${CHECK_DOCS_BASE:-}
hook=
while [ $# -gt 0 ]; do
	case $1 in
	--base) base=${2:?--base needs a ref}; shift 2 ;;
	--hook) hook=${2:?--hook needs a name}; shift 2 ;;
	-h | --help) sed -n '2,27s/^# \{0,1\}//p' "$0"; exit 0 ;;
	*) echo "check-docs: unknown argument $1" >&2; exit 64 ;;
	esac
done

if [ "$hook" = claude ]; then
	input=$(cat)
	case $input in *'"stop_hook_active":true'* | *'"stop_hook_active": true'*) exit 0 ;; esac
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root"

if [ -z "$base" ]; then
	base=$(git merge-base HEAD '@{upstream}' 2>/dev/null) ||
		base=$(git merge-base HEAD origin/HEAD 2>/dev/null) ||
		base=
fi

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
: >"$tmp/needs"   # files whose change needs a docs change
: >"$tmp/docs"    # changed files under docs/

record() { # sorts each changed path into needs or docs
	while IFS= read -r f; do
		case $f in
		'') ;;
		docs/*) echo "$f" >>"$tmp/docs" ;;
		*.md | *.mdx | LICENSE* | .gitignore | .gitattributes) ;;
		*) [ "${1:-}" = exempt ] || echo "$f" >>"$tmp/needs" ;;
		esac
	done
}

# Committed changes since the base, one commit at a time so a "Docs: none"
# trailer exempts only the commit that carries it.
if [ -n "$base" ]; then
	for c in $(git rev-list --no-merges "$base"..HEAD); do
		if git log -1 --format=%B "$c" | grep -qiE '^Docs:[[:space:]]*none[[:space:]]*$'; then
			git diff-tree --no-commit-id --name-only -r "$c" | record exempt
		else
			git diff-tree --no-commit-id --name-only -r "$c" | record
		fi
	done
fi

# Uncommitted changes, staged or not, and untracked files.
if git rev-parse --verify -q HEAD >/dev/null; then
	git diff --name-only HEAD | record
else
	git diff --name-only --cached | record
fi
git ls-files --others --exclude-standard | record

problems=$tmp/problems
: >"$problems"

if [ -s "$tmp/needs" ] && [ ! -s "$tmp/docs" ]; then
	{
		echo "Files changed outside docs/ with no change in docs/:"
		sort -u "$tmp/needs" | sed 's/^/  /'
		echo "  Update the doc that covers this change, or add one and list it in docs/README.md."
		echo "  If there is nothing to document, commit with the trailer \"Docs: none\"."
	} >>"$problems"
fi

if [ -d docs ]; then
	if [ ! -f docs/README.md ]; then
		echo "docs/README.md is missing: it is the index of docs/." >>"$problems"
	else
		find docs -type f -name '*.md' ! -path docs/README.md | sort | while IFS= read -r f; do
			rel=${f#docs/}
			listed=
			grep -qF "$rel" docs/README.md && listed=yes
			dir=$(dirname "$rel")
			while [ -z "$listed" ] && [ "$dir" != . ]; do
				grep -qF "$dir/" docs/README.md && listed=yes
				dir=$(dirname "$dir")
			done
			[ -n "$listed" ] || echo "$f is not listed in docs/README.md." >>"$problems"
		done
	fi

	find docs -type f -name '*.md' | sort | while IFS= read -r f; do
		# The first non-blank line is a heading; the next one is plain text.
		awk '
			/^[[:space:]]*$/ { next }
			!h { if ($0 !~ /^# /) exit 1; h = 1; next }
			{ if ($0 ~ /^([#>|*-]|```|[0-9]+\.)/) exit 1; ok = 1; exit 0 }
			END { if (!ok) exit 1 }
		' "$f" || echo "$f must open with a \"# Heading\" and then a one-line summary." >>"$problems"
	done

	# Rule 5. Two records with one number came from branches that each took "the next one".
	# The pairs listed here are the only ones allowed; a third record with either number, or a
	# new pair, fails.
	SHARED_NUMBERS=" 0039-link-previews-without-the-inviter.md 0039-messages-through-lighthouses.md 0040-a-content-security-policy-from-headers.md 0040-minor-versions-for-bigger-features.md "
	if [ -d docs/decisions ]; then
		find docs/decisions -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-*.md' | sed 's|.*/||' | sort | cut -c1-4 | uniq -d |
			while IFS= read -r n; do
				for f in docs/decisions/"$n"-*.md; do
					case $SHARED_NUMBERS in
					*" ${f##*/} "*) ;;
					*) echo "$f shares the number $n with another decision record; take the number after the highest." >>"$problems" ;;
					esac
				done
			done
	fi

	# Rule 6. A cited path that has gone is a doc that has drifted. Two kinds of citation are
	# read, outside fenced blocks: a `code span` that starts at a top-level folder, or at one of
	# the web app's own (ui/, app/, platform/, shell/, which the docs write relative to
	# apps/web/src/), and the target of a [link](target). A bare file name or a placeholder such as
	# apps/<name>/ is not read. A trailing :line:col, ?query or #anchor, and a leading ./, are
	# not part of the path.
	for doc in docs/architecture.md docs/verification.md; do
		[ -f "$doc" ] || continue
		prose=$(awk '/^(```|~~~)/ { fenced = !fenced; next } !fenced' "$doc")
		clean() { sed -E 's/[#?].*$//; s/(:[0-9]+){1,2}(-[0-9]+)?$//; s|^\./||'; }
		{
			printf '%s\n' "$prose" | grep -oE '`[^`]+`' | tr -d '`' | clean |
				grep -E '^(apps|packages|docs|scripts|verification|biome-plugins|vendor|assets|\.github|ui|app|platform|shell)/' |
				grep -vE '[<>*{} ]|\.\.\.' | while IFS= read -r span; do
					case $span in
					ui/* | app/* | platform/* | shell/*) [ -e "apps/web/src/$span" ] || [ -e "$span" ] || echo "$span" ;;
					*) [ -e "$span" ] || echo "$span" ;;
					esac
				done
			printf '%s\n' "$prose" | sed -E 's/`[^`]*`//g' | grep -oE '\]\([^)]+\)' |
				sed -E 's/^\]\(//; s/\)$//' | clean | grep -vE '^$|^[a-z]+:|^/' | while IFS= read -r link; do
				[ -e "$(dirname "$doc")/$link" ] || echo "$(dirname "$doc")/$link"
			done
		} | sort -u | while IFS= read -r path; do
			echo "$doc cites $path, which does not exist." >>"$problems"
		done
	done
else
	echo "docs/ is missing." >>"$problems"
fi

# Rule 4. The patterns catch "decision 0024", "decision records 0024", "ADR 0024",
# "decisions/0024-...", "(0024)", "(see x; 0024)", "[0024]", "see 0024", "before 0024",
# "0024 says", links to roadmap.md, and milestone tags such as M13, but not SVG path
# data such as "M3 10" or the docs index's own roadmap entry. Untracked files count; vendored
# test vectors, whose base64 and hex spell anything, are left out.
cite='[Dd]ecisions?( records?)?[ /-]+0[0-9]{3}|ADR[ -]?0[0-9]{3}|\((0[0-9]{3}[,;) ]|[^)]*; 0[0-9]{3})|\[0[0-9]{3}\]|\b(see|before|since|from) 0[0-9]{3}([^-0-9]|$)|\b0[0-9]{3} says|\bM[0-9]{1,2}([^0-9 .,]| [^0-9-]|[.,]( |$)|$)|[Hh]omelab|[(/]roadmap\.md(\)([^:]|$)|[^)]|$)'
if git grep --untracked -nIE "$cite" -- . ':!docs/decisions/' ':!docs/roadmap.md' ':!docs/roadmap-*.md' ':!scripts/check-docs' \
	':!*.svg' ':!*.lock.json' ':!pnpm-lock.yaml' ':!**/LICENSES/**' ':!packages/core/src/testing/wycheproof/**' >"$tmp/cites"; then
	{
		echo "Decision, milestone or personal references outside docs/decisions/ and the roadmap:"
		sed 's/^/  /' "$tmp/cites"
		echo "  Write for a stranger: say what is so, and why, without pointing at a record (AGENTS.md)."
	} >>"$problems"
fi

# Rule 5. No divider comments in code: a comment line that is, or starts with, a run of =, -, *,
# # or ~ fences off a section rather than saying anything about the code beside it.
divider='^[[:space:]]*(//|/\*|\*|#)[[:space:]]*(={4,}|-{4,}|\*{4,}|#{4,}|~{4,})'
if git grep --untracked -nIE "$divider" -- '*.ts' '*.tsx' '*.js' '*.mjs' '*.rs' '*.css' \
	':!**/node_modules/**' ':!packages/crypto-wasm/pkg/**' >"$tmp/dividers"; then
	{
		echo "Divider comments in code:"
		sed 's/^/  /' "$tmp/dividers"
		echo "  A comment says what the code beside it does, or why; a file that needs sections is several files (CONTRIBUTING.md)."
	} >>"$problems"
fi

[ -s "$problems" ] || exit 0

echo "check-docs: docs/ is out of step with this change." >&2
cat "$problems" >&2
[ "$hook" = claude ] && exit 2
exit 1
